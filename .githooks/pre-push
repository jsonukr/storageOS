#!/bin/sh
#
# StorageOS release policy: a version bump is required whenever shippable
# code changes (apps/, services/, crates/). Docs / CI / site-only pushes are
# allowed without a bump.
#
# Bump with:  node scripts/bump-version.mjs
# Enabled via:  git config core.hooksPath .githooks
#

zero=0000000000000000000000000000000000000000
VERSION_FILE="apps/desktop/src-tauri/Cargo.toml"

while read local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha~1..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # Only enforce a bump when shippable code changed in this push. The update
  # manifest (version.json) is config served by the relay, not code — exclude it.
  if git diff --name-only "$range" 2>/dev/null \
       | grep -vE '^services/storageos-relay/version\.json$' \
       | grep -qE '^(apps/|services/|crates/)'; then
    if ! git diff "$range" -- "$VERSION_FILE" 2>/dev/null | grep -qE '^\+version = "[0-9]+\.[0-9]+\.[0-9]+"'; then
      echo "────────────────────────────────────────────────────────────────────"
      echo " ✗ Push blocked — app/service code changed but no version bump."
      echo ""
      echo "   StorageOS policy: bump the version when shipping code changes."
      echo "   Run:   node scripts/bump-version.mjs"
      echo "   then:  commit the change and push again."
      echo "────────────────────────────────────────────────────────────────────"
      exit 1
    fi
  fi
done
exit 0

# StorageOS — single source of truth for the app version.
#
# This is the ONLY place the version is authored by hand. Every native config
# file (Cargo.toml, tauri.conf.json, package.json, build.gradle.kts,
# version.json, the download site) is generated FROM these values — never edit
# the version in those files directly, it will be overwritten.
#
# Bump + propagate:   node scripts/bump-version.mjs [patch|minor|major]
# Re-propagate only:  node scripts/bump-version.mjs sync
#
# VERSION_CODE is Android's integer versionCode (Google Play requires it to
# strictly increase); the bump script increments it by 1 on every version bump.
VERSION=0.1.4
VERSION_CODE=5
